{
  "expo": {
    "name": "taxman.manoj",
    "slug": "taxman-manoj",
    "version": "1.0.0",
    "description": "taxman.manoj — Your Compliance. Simplified. Premium tax & compliance client portal.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taxmanmanoj",
    "userInterfaceStyle": "automatic",
    "backgroundTextColor": "#0A0F1D",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fintechtax.h8pz9e"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0F1D"
      },
      "package": "com.emergent.fintechtax.h8pz9e"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1D"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
